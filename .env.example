TZ=Europe/London
LOG_LEVEL=INFO

BACKEND_PORT=9176
FRONTEND_PORT=9177

DATABASE_URL=sqlite+aiosqlite:////app/data/kerotrack.db

# Session signing key for the auth cookie (ADR-0005). Generate with:
#   openssl rand -hex 32
APP_SECRET_KEY=

# Image tag pulled by the production compose.yaml. Defaults to `latest`.
# Pin to a specific release (e.g. v1.0.0) for reproducible deploys.
# KEROTRACK_TAG=latest

# Set to `false` for plain-HTTP local dev. Defaults to `true` (assumes
# nginx-proxy-manager terminates TLS upstream).
# SESSION_COOKIE_SECURE=true
